# ==============================================================================
# ENVIRONMENT & SERVER SETTINGS
# ==============================================================================
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgresql://lead_app_user:dev_secret_lead_pass_2026@localhost:5432/lead_management_dev?sslmode=disable
DATABASE_TEST_URL=postgresql://lead_app_user:dev_secret_lead_pass_2026@localhost:5432/lead_management_test?sslmode=disable
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# ==============================================================================
# CORS & SECURITY
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ==============================================================================
# META MARKETING API (Phase 1 Milestone)
# ==============================================================================
# Graph API target version
META_GRAPH_API_VERSION=v21.0
# System User Access Token generated in Meta Business Manager (Permanent)
META_SYSTEM_USER_ACCESS_TOKEN=your_meta_system_user_token_placeholder
# Optional App Secret for generating appsecret_proof
META_APP_SECRET=your_meta_app_secret_placeholder

# ==============================================================================
# RAZORPAY PAYMENT GATEWAYS (Three Business Sources)
# ==============================================================================
# Source 1: VastuWheel Reports
RAZORPAY_ACCOUNT_ID_VASTUWHEEL=acc_placeholder_vastuwheel
RAZORPAY_KEY_ID_VASTUWHEEL=rzp_key_placeholder_vastuwheel
RAZORPAY_KEY_SECRET_VASTUWHEEL=rzp_secret_placeholder_vastuwheel
RAZORPAY_WEBHOOK_SECRET_VASTUWHEEL=rzp_webhook_secret_placeholder_vastuwheel

# Source 2: Vastu Webinars
RAZORPAY_ACCOUNT_ID_WEBINAR=acc_placeholder_webinar
RAZORPAY_KEY_ID_WEBINAR=rzp_key_placeholder_webinar
RAZORPAY_KEY_SECRET_WEBINAR=rzp_secret_placeholder_webinar
RAZORPAY_WEBHOOK_SECRET_WEBINAR=rzp_webhook_secret_placeholder_webinar

# Source 3: Vastu Consultancy
RAZORPAY_ACCOUNT_ID_CONSULTANCY=acc_placeholder_consultancy
RAZORPAY_KEY_ID_CONSULTANCY=rzp_key_placeholder_consultancy
RAZORPAY_KEY_SECRET_CONSULTANCY=rzp_secret_placeholder_consultancy
RAZORPAY_WEBHOOK_SECRET_CONSULTANCY=rzp_webhook_secret_placeholder_consultancy
