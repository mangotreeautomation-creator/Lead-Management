# ==============================================================================
# LEADPULSE ENTERPRISE SERVER ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and replace the placeholders with your actual secrets.
# ==============================================================================
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://lead_app_user:your_db_password_here@localhost:5432/lead_management_dev?sslmode=disable
DATABASE_TEST_URL=postgresql://lead_app_user:your_db_password_here@localhost:5432/lead_management_test?sslmode=disable
DB_POOL_MIN=2
DB_POOL_MAX=10
PG_ADMIN_PASSWORD=your_postgres_admin_password
DB_PASSWORD=your_db_password_here

# Security & Sessions
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECRET=your_leadpulse_cookie_signing_secret_min_32_characters
SESSION_TTL_HOURS=72

# Meta Marketing API (v21.0)
META_GRAPH_API_VERSION=v21.0
META_AD_ACCOUNT_ID=act_your_meta_ad_account_id
META_SYSTEM_USER_ACCESS_TOKEN=your_meta_system_user_token_placeholder
META_APP_SECRET=your_meta_app_secret_placeholder

# Razorpay Webhook Secrets & Credentials
# 1. GlobalInch (VastuWheel Reports & Palmistry)
RAZORPAY_ACCOUNT_ID_VASTUWHEEL=acc_placeholder_vastuwheel
RAZORPAY_KEY_ID_VASTUWHEEL=rzp_live_placeholder_vastuwheel
RAZORPAY_KEY_SECRET_VASTUWHEEL=your_razorpay_secret_placeholder_vastuwheel
RAZORPAY_WEBHOOK_SECRET_VASTUWHEEL=your_webhook_secret_placeholder_vastuwheel

# 2. Mango Tree Technology (Vastu Webinar)
RAZORPAY_ACCOUNT_ID_WEBINAR=acc_placeholder_webinar
RAZORPAY_KEY_ID_WEBINAR=rzp_live_placeholder_webinar
RAZORPAY_KEY_SECRET_WEBINAR=your_razorpay_secret_placeholder_webinar
RAZORPAY_WEBHOOK_SECRET_WEBINAR=your_webhook_secret_placeholder_webinar

# 3. Vastu Shikhar (Consultancy)
RAZORPAY_ACCOUNT_ID_CONSULTANCY=acc_placeholder_consultancy
RAZORPAY_KEY_ID_CONSULTANCY=rzp_live_placeholder_consultancy
RAZORPAY_KEY_SECRET_CONSULTANCY=your_razorpay_secret_placeholder_consultancy
RAZORPAY_WEBHOOK_SECRET_CONSULTANCY=your_webhook_secret_placeholder_consultancy

# In-House WhatsApp AI Portal
WHATSAPP_AI_PORTAL_WEBHOOK_SECRET=your_whatsapp_webhook_secret_placeholder
